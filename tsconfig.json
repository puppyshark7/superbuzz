{
  "compilerOptions": {
    "target": "ES2024",
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "deno"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipDefaultImportCheck": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["node_modules/**/*"]
}
